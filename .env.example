# 🔑 Ecosystem Environment Variables
# Copie este arquivo para ".env" e adicione suas chaves reais.
# Não faça commit do seu arquivo .env real no Git!

# OpenRouter (Recomendado para embeddings ultrarrápidos de livros via nomic-embed-text)
OPENROUTER_API_KEY=""

# OpenAI (Altíssima qualidade de embeddings - text-embedding-3-small)
OPENAI_API_KEY=""

# Google Gemini (Rápido e excelente para embeddings e insights)
GEMINI_API_KEY=""

# xAI (Grok)
XAI_API_KEY=""

# Groq (Excelente para processamento LLM super rápido)
GROQ_API_KEY=""

# ==========================================
# 📊 Configurações Globais do Jira
# ==========================================
JIRA_DOMAIN="sua-empresa.atlassian.net"
JIRA_EMAIL="seu-email@dominio.com"
JIRA_TOKEN="seu_token_aqui"
JIRA_PROJECT_KEY="GARE"

# ==========================================
# 🐙 Configurações Globais do GitHub
# ==========================================
GITHUB_USER="seu_usuario_github"
GITHUB_REPO_URL="https://github.com/usuario/repositorio"
GITHUB_TOKEN="seu_token_github"
